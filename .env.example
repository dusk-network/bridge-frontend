# Reown AppKit project ID. Required for WalletConnect and the wallet modal.
VITE_REOWN_PROJECT_ID=

# Dusk networks. Legacy bridge routes switch to mainnet; DuskEVM routes switch
# to the configured L1 network.
VITE_DUSK_MAINNET_CHAIN_ID=dusk:1
VITE_DUSK_MAINNET_NODE_URL=https://nodes.dusk.network
VITE_DUSK_MAINNET_EXPLORER_URL=https://apps.dusk.network/explorer
VITE_DUSK_TESTNET_CHAIN_ID=dusk:2
VITE_DUSK_TESTNET_NODE_URL=https://testnet.nodes.dusk.network
VITE_DUSK_TESTNET_EXPLORER_URL=https://apps.testnet.dusk.network/explorer

# DuskEVM testnet public endpoints.
VITE_DUSKEVM_CHAIN_ID=745
VITE_DUSKEVM_NAME=DuskEVM Testnet
VITE_DUSKEVM_RPC_URL=https://rpc.testnet.evm.dusk.network
VITE_DUSKEVM_EXPLORER_URL=https://explorer.testnet.evm.dusk.network
VITE_DUSKEVM_L1_CHAIN_ID=dusk:2
VITE_DUSKEVM_L1_NODE_URL=https://testnet.nodes.dusk.network

# Pin these full 32-byte Dusk contract IDs from the deployment address book.
VITE_DUSKEVM_L1_STANDARD_BRIDGE_CONTRACT_ID=
VITE_DUSKEVM_OPTIMISM_PORTAL_CONTRACT_ID=
VITE_DUSKEVM_DISPUTE_GAME_FACTORY_CONTRACT_ID=

# RPC exposing DuskEVM's L1 projection through eth_call.
VITE_DUSKEVM_L1_BRIDGE_RPC_URL=
VITE_DUSKEVM_BRIDGE_GAME_SEARCH_DEPTH=64

# The canonical data drivers are included in public/drivers.
VITE_DUSKEVM_OPTIMISM_PORTAL_DATA_DRIVER_URL=/drivers/optimism_portal_dd_opt.wasm
VITE_DUSKEVM_DISPUTE_GAME_FACTORY_DATA_DRIVER_URL=/drivers/dispute_game_factory_dd_opt.wasm

# Optional RPC overrides for legacy token balance/simulation reads.
VITE_ETHEREUM_RPC_URL=https://ethereum-rpc.publicnode.com
VITE_BSC_RPC_URL=https://bsc-dataseed.binance.org
