# Reown AppKit project ID. Required for WalletConnect and the wallet modal.
VITE_REOWN_PROJECT_ID=

# The network this deployment serves: `mainnet` (default) or `testnet`. Every
# route stays on that network's counterparts; nothing mixes the two.
VITE_BRIDGE_PROFILE=mainnet

# Dusk node and explorer for the profile. The bridge reads chain state from
# this node directly; the wallet extension only signs and sends.
VITE_DUSK_NODE_URL=
VITE_DUSK_EXPLORER_URL=

# Multicall for Dusk batches several contract reads into one node query.
# `none` turns batching off.
VITE_DUSK_MULTICALL_CONTRACT_ID=93de287b7d349d678a0038fe7772e8960e1a84a1b5da2d0b1f62f532616ce1d4

# The highest gas limit the bridge asks the wallet for.
VITE_GAS_LIMIT_UPPER=1000000000

# DuskEVM routes appear only when all of these are set. Testnet has defaults
# for the endpoints; mainnet has none until DuskEVM mainnet is live.
# Testnet (26 Oct 2026, as in the testnet web wallet):
#   VITE_DUSKEVM_L1_STANDARD_BRIDGE_CONTRACT_ID=2257e5f8ff49cf7c9704a14ca35acbf48eb7ade11a079d98d5cd5655eea1b31d
#   VITE_DUSKEVM_OPTIMISM_PORTAL_CONTRACT_ID=14eeb3d4021aff09af2c515603a01f8d956a7f6411d11a1b1c0b0561a93fb1b9
#   VITE_DUSKEVM_DISPUTE_GAME_FACTORY_CONTRACT_ID=3b7d562aa0e6b94ce29c5ce2a6f0587ad771afdace86abb0baf66f93e49548cd
VITE_DUSKEVM_L1_STANDARD_BRIDGE_CONTRACT_ID=
VITE_DUSKEVM_OPTIMISM_PORTAL_CONTRACT_ID=
VITE_DUSKEVM_DISPUTE_GAME_FACTORY_CONTRACT_ID=
# Optional: the anchor state registry the Portal asks whether a dispute game
# is proper and respected. With it, a proof goes against a game that has
# already resolved, so its claim date is exact; `none` leaves it out. Testnet
# defaults to DuskEVM testnet's (address book, testnet/l1-addresses.json):
#   1735498c11978854e390894502850916f4ba619e3f4b88c10ef758c5026619cc
VITE_DUSKEVM_ANCHOR_STATE_REGISTRY_CONTRACT_ID=
# The chain name wallets list for DuskEVM (the page itself says "DuskEVM").
VITE_DUSKEVM_NAME=
VITE_DUSKEVM_CHAIN_ID=
VITE_DUSKEVM_RPC_URL=
VITE_DUSKEVM_EXPLORER_URL=
# The DuskEVM adapter's Ethereum-compatible view of Dusk, asked only which
# DuskEVM deposit a Dusk transaction made. Dispute games are read on Dusk.
VITE_DUSKEVM_L1_BRIDGE_RPC_URL=
VITE_DUSKEVM_BRIDGE_GAME_SEARCH_DEPTH=64

# The data drivers default to the reviewed copies in public/drivers, checked
# against their pinned SHA-256 before they run.
VITE_DUSKEVM_OPTIMISM_PORTAL_DATA_DRIVER_URL=
VITE_DUSKEVM_OPTIMISM_PORTAL_DATA_DRIVER_SHA256=
VITE_DUSKEVM_DISPUTE_GAME_FACTORY_DATA_DRIVER_URL=
VITE_DUSKEVM_DISPUTE_GAME_FACTORY_DATA_DRIVER_SHA256=

# The Ethereum and BNB Smart Chain routes. Comma-separated networks to migrate
# from (`ethereum`, `bsc`), and the network the operated Dusk → EVM transfer
# pays out on. `none` turns a route off. Defaults: mainnet `ethereum,bsc` and
# `bsc`; testnet `ethereum` (Sepolia) for both. Empty values everywhere mean
# the default.
VITE_MIGRATION_NETWORKS=
VITE_SERVICE_NETWORK=
VITE_SERVICE_BRIDGE_ACCOUNT=
VITE_SERVICE_BRIDGE_FEE_LUX=1000000000
# Optional: the account the bridge pays out from, to narrow payout lookups.
VITE_SERVICE_BRIDGE_PAYOUT_ADDRESS=
# The Dusk account each chain's migrations are paid from: only its transfers
# of the migrated amount count as a migration's payout. Mainnet has both by
# default; `none` counts any sender's. The first sets both chains.
VITE_MIGRATION_PAYOUT_ACCOUNT=
VITE_ETHEREUM_PAYOUT_ACCOUNT=
VITE_BSC_PAYOUT_ACCOUNT=
# Routes shown as not running right now, by route ID. Default on testnet:
# `ethereum-to-dusk,dusk-to-ethereum` (the Sepolia routes); `none` runs them.
VITE_PAUSED_ROUTES=
# How long each route usually takes on this network, in seconds. Empty keeps
# the profile's value (src/config.js says where each comes from), `none`
# shows no time. The chains' own figures replace the DuskEVM deposit's.
VITE_ETHEREUM_MIGRATION_SECONDS=
VITE_BSC_MIGRATION_SECONDS=
VITE_SERVICE_BRIDGE_DELAY_SECONDS=
VITE_DUSKEVM_DEPOSIT_SECONDS=

# Who runs each route, as it should be named: Dusk unless set.
VITE_MIGRATION_OPERATOR=
VITE_SERVICE_OPERATOR=
VITE_DUSKEVM_OPERATOR=
# Shown only when set: where to ask when a transfer is late, and what to call it.
VITE_SUPPORT_URL=
VITE_SUPPORT_LABEL=
# Each network's own bridge site, linked from the other one.
VITE_MAINNET_BRIDGE_URL=
VITE_TESTNET_BRIDGE_URL=
# Dusk's Terms of use and Privacy policy unless set.
VITE_TERMS_URL=
VITE_PRIVACY_URL=
VITE_STATUS_URL=
# Guides for this page, per route; none is linked unless set.
VITE_DOCS_MIGRATION_URL=
VITE_DOCS_SERVICE_URL=
VITE_DOCS_DUSKEVM_URL=

# Optional overrides per EVM network (also needed to add one a profile lacks).
VITE_ETHEREUM_CHAIN_ID=
VITE_ETHEREUM_CHAIN_NAME=
VITE_ETHEREUM_RPC_URL=
VITE_ETHEREUM_EXPLORER_URL=
VITE_ETHEREUM_TOKEN_CONTRACT=
VITE_ETHEREUM_MIGRATION_CONTRACT=
VITE_BSC_CHAIN_ID=
VITE_BSC_CHAIN_NAME=
VITE_BSC_RPC_URL=
VITE_BSC_EXPLORER_URL=
VITE_BSC_TOKEN_CONTRACT=
VITE_BSC_MIGRATION_CONTRACT=
